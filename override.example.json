{
    // override.json мёржится поверх config.json при старте.
    // Удобен для временных изменений: config.json сохраняется через UI
    // и перезаписывается, а override.json лежит руками и остаётся как
    // есть. Глубокая вложенность поддерживается — достаточно указать
    // только те ветки, которые нужно переопределить.
    //
    // Файл подхватывается автоматически, если имя совпадает с
    // server.override_file в config.json (по умолчанию "override.json").

    "logging": {
        // INFO по умолчанию, DEBUG — когда разбираетесь с проблемой.
        // Временное включение: поменяли, рестарт, посмотрели, вернули.
        "level": "DEBUG"
    },

    "analytics": {
        // Сборщик статистики URL. Пишет JSONL в /app/logs/url_analytics.jsonl.
        // Полезен, если хотите понять, правильно ли резолвер угадывает
        // TTL для нестандартных CDN. По умолчанию выключен.
        "enabled": true
    },

    "healthcheck": {
        // Планировщик проактивных проверок. Уменьшайте workers, если
        // sniffer (Chromium) ест CPU при нескольких параллельных проверках.
        "workers": 2
    }
}
