{
    // override.json мёржится поверх config.json при старте (глубоко, по веткам).
    // Удобен для временных изменений: config.json перезаписывается из UI, а этот
    // файл лежит руками и остаётся как есть. Файл подхватывается автоматически,
    // если его имя совпадает с server.override_file в config.json.
    //
    // Важно: значение из override.json сильнее и config.json, и переменных
    // окружения — сюда стоит класть только то, что действительно нужно
    // переопределить.
    // Комментарии // и висячие запятые парсер понимает (JSONC-style).

    "logging": {
        // INFO по умолчанию; DEBUG — когда разбираетесь с проблемой.
        // Временное включение: поменяли, рестарт, посмотрели, вернули.
        "level": "DEBUG",

        // Отдельный журнал событий каналов (изменения конфигурации, UP/DOWN).
        "channel_events_log": "/app/logs/channel_events.log"
    },

    "analytics": {
        // Сборщик статистики URL: пишет JSONL рядом с логами. Полезен, когда
        // хотите понять, правильно ли сервис определяет срок жизни ссылок
        // у нестандартного CDN. По умолчанию выключен.
        "enabled": true
    },

    "healthcheck": {
        // Параллельные проверки каналов и частота планировщика.
        // Уменьшайте workers, если headless-браузер (sniffer) ест CPU.
        "workers": 2,
        "scheduler_interval": 60,

        // Минимальный интервал между проверками канала. Ставить его больше
        // срока жизни ссылок канала не имеет смысла — payload успеет протухнуть.
        "scheduler_min_interval": 300,

        // Канал, который только что смотрели, планировщик не трогает.
        "recently_active_sec": 120
    },

    "resolver": {
        // Таймауты резолверов (секунды). Поднимать, если источник медленный.
        "streamlink_timeout": 30,
        "flaresolverr_timeout": 60,
        "playwright_navigation_timeout": 50,
        "fetch_timeout": 15
    },

    "mux": {
        // Уровень логов ffmpeg: warning | info | debug.
        "ffmpeg_log_level": "warning",
        "idle_timeout": 90
    },

    "limits": {
        // Семафоры параллельных операций: браузер, FlareSolverr, ffprobe, резолверы.
        "sniffer": 3,
        "flaresolverr": 2,
        "probe": 2,
        "resolver": 4
    }
}
